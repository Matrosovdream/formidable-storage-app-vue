# Copy this file to .env and adjust as needed.

# ---- Frontend (Vite) ----
# Backend API base URL. In prod this is baked into the bundle at build time.
VITE_API_BASE_URL=http://localhost:8080

# ---- Deployment (compose.prod.yaml + Traefik) ----
# Short slug — used for image name, container name, and Traefik router/service name.
APP_NAME=formidable-storage-app
# Public hostname Traefik routes to this app.
APP_HOST=app.example.com
# Name of the Traefik certresolver configured on the host (e.g. "le" for Let's Encrypt).
TRAEFIK_CERTRESOLVER=le

# ---- Deployment (compose.dev.yaml) ----
# Host port to expose the Vite dev server on (default 7070).
DEV_PORT=7070
